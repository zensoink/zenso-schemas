{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.zenso.ink/v1/plugin-manifest.schema.json",
  "title": "Zenso Plugin Manifest",
  "description": "Declares metadata, capabilities, instance config schema and data sources for a Zenso plugin. This is the source of truth for the plugin contract — align zod and panel code to this.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL of the manifest schema this file conforms to."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+/[a-z0-9-]+$",
      "description": "Unique plugin identifier (owner/repo format)."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "thumbnail": {
      "type": "string",
      "description": "Relative path to a preview image bundled with the plugin."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1,
      "description": "Must match the schema major version in the URL."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Plugin version (SemVer X.Y.Z)."
    },
    "core_min": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Minimum Zenso core version required."
    },
    "license": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": ["script"]
      },
      "uniqueItems": true,
      "description": "Runtime capabilities the plugin needs. Only \"script\" is supported; it allows bundled .js files."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "config_schema": {
      "type": "object",
      "description": "JSON Schema (draft-07) of the plugin instance configuration (configJson). Property types must be renderable by the Zenso panel: string | number | boolean | array.",
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "array"
                ]
              },
              "description": {
                "type": "string"
              },
              "default": {},
              "format": {
                "type": "string"
              },
              "enum": {
                "type": "array",
                "minItems": 1
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "items": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "format": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Data source type handler. Currently supported: ics."
          },
          "config": {
            "type": "object"
          },
          "refresh_ttl": {
            "type": "number",
            "minimum": 1,
            "description": "Cache TTL in seconds. Server enforces a minimum of 300."
          }
        },
        "required": [
          "id",
          "type"
        ]
      }
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "schema_version",
    "core_min",
    "config_schema"
  ]
}
